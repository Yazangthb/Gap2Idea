# --- LLM provider ---
# Pick one provider. LLM_PROVIDER selects it; if unset, Yandex is used when its
# keys are present, otherwise OpenRouter.
# LLM_PROVIDER=openrouter        # or "yandex"

# OpenRouter: one OpenAI-compatible key for GPT, Claude, Gemini, Llama, etc.
# Swap models with the --model flag (slugs like openai/gpt-4.1-mini).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional analytics/telemetry headers (shown on the OpenRouter leaderboard).
# Leave blank to skip.
OPENROUTER_REFERRER=
OPENROUTER_TITLE=Gap2Idea

# Optional: override the default base URL (useful for self-hosted gateways).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Yandex Cloud Foundation Models (YandexGPT). An OpenAI-compatible endpoint;
# model slugs are rewritten to gpt://<folder>/<model>/latest automatically, so
# the same code and --model flags work unchanged. Supports strict JSON schema.
# Create an API key + folder in the Yandex Cloud console.
# LLM_PROVIDER=yandex
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt         # or yandexgpt-lite (cheaper, weaker)
# YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1

# --- Semantic Scholar (recommended) ---
# Without a key the unauthenticated tier is ~100 requests / 5 min, shared per IP,
# which is easy to hit when running `fetch-metadata` on a large corpus.
# Request one at https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=

# --- Direct OpenAI (legacy / fallback) ---
# Only used if OPENROUTER_API_KEY is unset. Most users won't need this.
# OPENAI_API_KEY=
