# Mirror of .dockerignore for `gcloud builds submit` upload.
.git
.gitignore
.venv/
.uv-venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.claude/
.streamlit/secrets.toml

# Secrets
.env
.env.*

# Large host-only data — same allowlist as .dockerignore so the build context
# carries the demo bundle but not the huge raw inputs.
data/*
!data/.gitkeep
!data/methods.tsv
!data/papers_subset.tsv

artifacts/*
!artifacts/.gitkeep
!artifacts/cluster_labels.tsv
!artifacts/cluster_pairs.tsv
!artifacts/cluster_summary.tsv
!artifacts/gaps_clean.tsv
!artifacts/gaps_with_clusters.tsv
!artifacts/papers_metadata.tsv
!artifacts/ideas.tsv
!artifacts/ideas_full.jsonl
!artifacts/idea_eval.tsv
!artifacts/evaluation_report.md
!artifacts/gap_embeddings.npy
!artifacts/method_embeddings.npy

notebooks/

# Local TSV scratch files
gaps_clean.tsv
gaps_openai_10.tsv
gaps_sample.tsv
gaps_sample_10.tsv
payload.json
