%% Gap2Idea — orchestrated multi-agent idea generation (thesis Figure 3)
%% Reflects pipeline/orchestrator.py + pipeline/agents.py on master

flowchart TD
    IN1["theme evidence<br/>cluster gaps"]
    IN2["paper metadata"]
    IN3["methods.tsv<br/>optional"]

    IN1 --> SYN
    IN2 --> SYN
    IN3 --> SYN

    subgraph LOOP["per-pair or per-cluster loop"]
        SYN["Synthesiser agent"]
        SYN -->|"draft idea"| CR
        CR["Critic agent"]
        CR -->|"tool calls"| TOOLS
        CR -->|"critique and revision targets"| REV{"accept?"}
        REV -->|"no, revise"| SYN
        REV -->|"yes"| FINAL["final idea draft"]
    end

    subgraph TOOLS["tool surface"]
        T1["S2 novelty search"]
        T2["evidence-overlap check"]
        T3["corpus retrieval"]
    end

    FINAL --> JP

    subgraph JP["JudgePanel: N independent judges"]
        J1["Judge A<br/>e.g. Claude Sonnet"]
        J2["Judge B<br/>e.g. GPT-4o"]
        J3["Judge C<br/>e.g. Gemini"]
    end

    J1 --> AGG1
    J2 --> AGG1
    J3 --> AGG1

    AGG1["aggregate scores"]
    AGG2["inter-judge agreement"]
    AGG1 --> AGG2

    AGG2 --> PERSIST["persist run"]

    subgraph ARTIFACTS["artifacts"]
        OUT1["ideas.tsv<br/>flat view"]
        OUT2["ideas_full.jsonl<br/>provenance"]
        OUT3["idea_eval.tsv<br/>scores"]
    end

    PERSIST --> OUT1
    PERSIST --> OUT2
    PERSIST --> OUT3

    classDef agent fill:#e7f0ff,stroke:#2b5fa6,color:#0e2c52;
    classDef tool fill:#fff7e0,stroke:#aa7700,color:#553300;
    classDef artifact fill:#eef,stroke:#669,color:#223;
    classDef decision fill:#fdf,stroke:#a3a,color:#222;
    classDef step fill:#fff,stroke:#444,color:#111;
    class SYN,CR,J1,J2,J3 agent;
    class T1,T2,T3 tool;
    class IN1,IN2,IN3,FINAL,AGG1,AGG2,OUT1,OUT2,OUT3 artifact;
    class PERSIST step;
    class REV decision;
