%% Gap2Idea — orchestrated multi-agent idea generation (thesis Figure 3)
%% Reflects pipeline/orchestrator.py + pipeline/agents.py on master

flowchart TD
    IN[theme evidence<br/>cluster gaps · paper metadata<br/>methods.tsv ·optional·] --> SYN

    subgraph LOOP[per-pair / per-cluster loop]
        SYN[Synthesiser agent<br/>OpenRouter · strict JSON]
        SYN -->|draft idea| CR
        CR[Critic agent]
        CR -->|tool calls| TOOLS
        CR -->|critique + revision targets| REV{accept?}
        REV -- no, revise --> SYN
        REV -- yes --> FINAL[final idea draft]
    end

    subgraph TOOLS[tool surface]
        T1[S2 novelty search]
        T2[evidence-overlap check]
        T3[corpus retrieval]
    end

    FINAL --> JP

    subgraph JP[JudgePanel · N independent judges]
        J1[Judge A<br/>e.g. Claude Sonnet]
        J2[Judge B<br/>e.g. GPT-4o]
        J3[Judge C<br/>e.g. Gemini]
    end

    J1 --> AGG[aggregate scores<br/>+ inter-judge agreement]
    J2 --> AGG
    J3 --> AGG

    AGG --> OUT["artifacts/<br/>ideas.tsv  (flat row, mode=orchestrated)<br/>ideas_full.jsonl  (prompt + critiques + panel)<br/>idea_eval.tsv  (panel-judged scores)"]

    classDef agent fill:#e7f0ff,stroke:#2b5fa6,color:#0e2c52;
    classDef tool fill:#fff7e0,stroke:#aa7700,color:#553300;
    classDef artifact fill:#eef,stroke:#669,color:#223;
    classDef decision fill:#fdf,stroke:#a3a,color:#222;
    class SYN,CR,J1,J2,J3 agent;
    class T1,T2,T3 tool;
    class IN,FINAL,OUT,AGG artifact;
    class REV decision;
