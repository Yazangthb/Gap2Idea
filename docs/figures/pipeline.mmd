%% Gap2Idea — end-to-end pipeline (thesis Figure 1)
%% Compact layout using subgraphs so it fits a standard thesis page.

flowchart TB
    %% ============================================================
    %% A. Acquisition  (corpus → text → sections → gaps + methods)
    %% ============================================================
    subgraph ACQ["A. Data acquisition and extraction"]
        direction LR
        A0["arXiv snapshot<br/>or S2 query"] -->|"select-papers"| A1["papers_subset.tsv"]
        A1 -->|"download-pdfs"| A2["PDFs"]
        A2 -->|"extract-text"| A3["paper_texts.jsonl"]
        A3 -->|"extract-sections"| A4["sections.jsonl"]
        A4 -->|"extract-gaps<br/>LLM, verbatim"| A5["gaps.tsv"]
        A3 -->|"extract-methods<br/>LLM, verbatim"| A6["methods.tsv"]
    end

    %% ============================================================
    %% B. Theme mining  (embed → cluster → label → bridge)
    %% ============================================================
    subgraph TM["B. Theme mining"]
        direction LR
        A5 -->|"theme-mine"| B1["gap_embeddings.npy"]
        A5 --> B2["cluster_labels.tsv"]
        A5 --> B3["cluster_pairs.tsv<br/>bridge-scored"]
    end

    %% ============================================================
    %% C. Idea generation  (4 modes)
    %% ============================================================
    A5 --> H{{"generate-ideas<br/>--mode"}}
    A6 --> H
    B1 --> H
    B2 --> H
    B3 --> H

    subgraph GEN["C. Idea generation"]
        direction LR
        H -->|"bridge"| I1["pair-based"]
        H -->|"within"| I2["per-cluster"]
        H -->|"method-gap"| I3["method × gap"]
        H -->|"orchestrated"| I4["multi-agent<br/>see Figure 3"]
    end

    I1 --> J1
    I2 --> J1
    I3 --> J1
    I4 --> J1

    J1["ideas.tsv + ideas_full.jsonl<br/>S2 novelty + evidence-overlap audit"]

    %% ============================================================
    %% D. Evaluation
    %% ============================================================
    J1 -->|"evaluate-ideas<br/>single judge or panel"| K["idea_eval.tsv<br/>evaluation_report.md"]

    %% ============================================================
    %% E. Export  (with paper-drafter branch)
    %% ============================================================
    J1 --> EX{{"export-ideas"}}

    subgraph EXPORT["D. Export"]
        direction LR
        EX -->|"library-pdf"| L1["consolidated PDF<br/>reportlab"]
        EX -->|"latex / rendered-pdf"| TPL["Jinja2 template<br/>minimal / standard / ieee / custom"]
        EX -->|"--full-paper"| PD["paper-drafter<br/>LLM expansion"]
        PD --> PDC["paper_drafts/&lt;id&gt;.json<br/>cached"]
        PDC --> TPL
        TPL -->|"tectonic / pdflatex"| L2["per-idea PDF<br/>with TODO callouts"]
        TPL --> L3[".tex<br/>Overleaf-ready"]
    end

    A5 -.-> FM["fetch-metadata<br/>S2 papers_metadata.tsv"]
    FM -.->|"optional --with-prior-art"| PD

    %% ============================================================
    %% F. MCP server  (alternative read entry point)
    %% ============================================================
    J1 -.-> MCP["serve-mcp<br/>MCP tools for Claude Desktop"]
    A5 -.-> MCP
    B2 -.-> MCP
    A6 -.-> MCP

    %% ============================================================
    %% Styling
    %% ============================================================
    classDef artifact fill:#eef,stroke:#669,color:#223;
    classDef stage fill:#fff,stroke:#444,color:#111;
    classDef decision fill:#fdf,stroke:#a3a,color:#222;
    classDef llm fill:#e7f0ff,stroke:#2b5fa6,color:#0e2c52;
    classDef iface fill:#e9f7e9,stroke:#487048,color:#223;

    class A1,A2,A3,A4,A5,A6,B1,B2,B3,I1,I2,I3,I4,J1,K,L1,L2,L3,PDC,TPL,FM artifact;
    class A0 stage;
    class H,EX decision;
    class PD llm;
    class MCP iface;
