# Env / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Project outputs / large files
# =========================
data/pdfs/
data/texts/
*.pdf
*.txt
*.tsv
*.jsonl
*.json
*.png

# extracted / intermediate corpora
data/sections_extracted.jsonl
data/sections_extracted.tsv
data/arxiv_texts.jsonl

# OpenAI outputs (keep if you want versioned; otherwise ignore)
# data/gaps_openai.tsv
# artifacts/ideas_openai.tsv

# artifacts (usually reproducible)
artifacts/
*.npy

# =========================
# Local runtime / streamlit
# =========================
.streamlit/
.streamlit/secrets.toml

!requirements.txt

# Benchmark outputs (whitelist past the global *.tsv / *.jsonl / *.png / *.npy ignores)
!data/bench/*.tsv
!data/bench/*.jsonl
!data/bench/*.md
!data/bench/plots/
!data/bench/plots/*.png
!data/bench_v2a/*.tsv
!data/bench_v2a/*.jsonl
!data/bench_v2a/*.md
!data/bench_v2a/plots/
!data/bench_v2a/plots/*.png
!data/bench_v2b/*.tsv
!data/bench_v2b/*.jsonl
!data/bench_v2b/*.md
!data/bench_v2b/plots/
!data/bench_v2b/plots/*.png
!data/bench_ablation.md
!data/bench_ablation_plots/
!data/bench_ablation_plots/*.png
!data/bench_n100/*.tsv
!data/bench_n100/*.jsonl
!data/bench_n100/*.md
!data/bench_n100/plots/
!data/bench_n100/plots/*.png

# Clustering-quality benchmark outputs (same whitelist pattern)
!data/clustering_bench/*.tsv
!data/clustering_bench/*.md
!data/clustering_bench/plots/
!data/clustering_bench/plots/*.png
!data/clustering_bench_n100/*.tsv
!data/clustering_bench_n100/*.md
!data/clustering_bench_n100/plots/
!data/clustering_bench_n100/plots/*.png

# but never the 4.8GB unarXive tarball, the downloaded arxiv PDFs, or
# embedding cache directories
data/bench/raw/
data/bench_v2b/pdfs/
data/bench_n100/pdfs/
data/clustering_bench/embeddings/
data/clustering_bench_n100/embeddings/

# FWS benchmark data caches (regenerable from the FWS repo URL)
data/fws_recognition.csv
data/fws_lemm.pkl

# LaTeX build artifacts
docs/mdpi_latex/*.aux
docs/mdpi_latex/*.bbl
docs/mdpi_latex/*.blg
docs/mdpi_latex/*.log
docs/mdpi_latex/*.out
docs/mdpi_latex/*.fls
docs/mdpi_latex/*.fdb_latexmk
docs/mdpi_latex/*.pdf
docs/mdpi_latex/build.log
