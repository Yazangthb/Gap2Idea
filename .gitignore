# =========================
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

# =========================
# IDEs
# =========================
.vscode/
.idea/
*.iml
.claude/

