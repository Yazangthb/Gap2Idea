# --- LLM provider (required) ---
# Gap2Idea routes all LLM calls through OpenRouter, which exposes an
# OpenAI-compatible API but lets you swap between GPT, Claude, Gemini,
# Llama etc. just by changing the --model flag.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional analytics/telemetry headers (shown on the OpenRouter leaderboard).
# Leave blank to skip.
OPENROUTER_REFERRER=
OPENROUTER_TITLE=Gap2Idea

# Optional: override the default base URL (useful for self-hosted gateways).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Semantic Scholar (recommended) ---
# Without a key the unauthenticated tier is ~100 requests / 5 min, shared per IP,
# which is easy to hit when running `fetch-metadata` on a large corpus.
# Request one at https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=

# --- Direct OpenAI (legacy / fallback) ---
# Only used if OPENROUTER_API_KEY is unset. Most users won't need this.
# OPENAI_API_KEY=
